# --- Chat model: Ollama Cloud (https://ollama.com) ---
# Create a key at https://ollama.com/settings/keys. Do NOT append /v1 — that's the
# OpenAI-compatible surface; this app uses the native ollama client (/api/chat).
OLLAMA_CHAT_HOST=https://ollama.com
OLLAMA_CHAT_API_KEY=your_ollama_cloud_api_key_here
# Any chat-capable model available to your key, e.g. gpt-oss:20b, qwen3.5:cloud — run
# `ollama list` against the cloud host (or check https://ollama.com/settings) to see yours.
OLLAMA_CHAT_MODEL=gpt-oss:20b    # qwen3.5:cloud

# --- Embedding model: local Ollama ---
# Ollama Cloud does not serve the /api/embed endpoint — embeddings must run on a local
# `ollama serve` instance. This repo ships EmbeddingGemma-300M as a GGUF in
# backend/models/embeddinggemma-300m/ — import it once with:
#   cd backend/models/embeddinggemma-300m && ollama create embeddinggemma:300m -f Modelfile
# (Any other pulled embedding model works too, e.g. nomic-embed-text, mxbai-embed-large.)
# No API key is needed for a local instance.
OLLAMA_EMBED_HOST=http://localhost:11434
OLLAMA_EMBED_API_KEY=
HF_EMBED_MODEL=embeddinggemma:300m

# Local SQLite database file (relative to backend/)
DATABASE_URL=sqlite:///./data/app.db

# Local Chroma persistence directory (relative to backend/)
CHROMA_DIR=./data/chroma

# Path to the source policy PDF used to build the RAG index
POLICY_PDF_PATH=./data/leave_policy.pdf

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

# Company / policy identity, surfaced in the UI
COMPANY_NAME=Code 19
POLICY_YEAR=2022
